{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*.local", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "EXPO_PUBLIC_API_URL"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**", "build/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    }
  }
}
